{
  "enabled": true,
  "network": {
    "strictAllowlist": true,
    "allowLocalBinding": false,
    "allowAllUnixSockets": false,
    "allowUnixSockets": [
      "/private/var/run/nix-daemon.socket"
    ],
    "allowMachLookup": [
      "com.apple.SystemConfiguration.DNSConfiguration",
      "com.apple.SystemConfiguration.configd"
    ],
    "allowedDomains": [
      "github.com",
      "api.github.com",
      "*.githubusercontent.com",
      "cache.nixos.org",
      "127.0.0.1:4226"
    ],
    "deniedDomains": [
      "*.flakehub.com"
    ]
  },
  "filesystem": {
    "denyRead": [
      "/var/log",
      "/Users"
    ],
    "allowRead": [
      ".",
      "~/.cache/nix",
      "~/.cargo",
      "~/.rustup",
      "~/.config/git",
      "~/.config/jj",
      "~/.gitconfig",
      "~/.local/bin",
      "~/.local/lib",
      "~/.local/state",
      "~/.ignore",
      "~/.nix-profile",
      "~/.nix-defexpr",
      "~/Workspaces",
      "~/Library/Caches/kache",
      "~/Library/Caches/Mozilla.sccache",
      "~/Library/Preferences/.GlobalPreferences.plist",
      "~/Library/Preferences/.GlobalPreferences_m.plist",
      "~/Library/Preferences/ByHost/.GlobalPreferences.*.plist"
    ],
    "allowWrite": [
      ".",
      "/dev/null",
      "/private/var/folders/fg",
      "/private/tmp",
      "~/.cache/nix",
      "~/.local/state",
      "~/Workspaces",
      "~/Library/Caches/kache",
      "~/Library/Caches/Mozilla.sccache"
    ],
    "denyWrite": [
      "**/*.key",
      "**/*.pem",
      "**/.env",
      "**/.env.*",
      "**/.git/hooks",
      "**/sandbox.json"
    ]
  },
  "ignoreViolations": {
    "*": [
      "deny(1) sysctl-read kern.iossupportversion",
      "deny(1) sysctl-read hw.usermem"
    ]
  }
}
