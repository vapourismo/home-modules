+async function unixSocketEndpoint(): Promise<UnixSocketEndpoint> {
+  const socketName =
+    `srt-mux-${process.pid}-${(backendSeq++).toString(36)}.sock`
+  const preferredPath = join(tmpdir(), socketName)
+  // macOS sockaddr_un.sun_path is 104 bytes including the trailing NUL. Nix
+  // shells can make TMPDIR too long even though the socket basename is short.
+  if (Buffer.byteLength(preferredPath) <= MAX_UNIX_SOCKET_PATH_BYTES) {
+    return { path: preferredPath }
+  }
+
+  // Use a private, unpredictable directory rather than placing a predictable
+  // socket directly in the shared /tmp directory.
+  const directory = await mkdtemp(join(SHORT_TMPDIR, 'srt-mux-'))
+  return { path: join(directory, 'http.sock'), directory }
+}
+
+async function removeUnixSocketEndpoint(
+  endpoint: UnixSocketEndpoint,
+): Promise<void> {
+  await unlink(endpoint.path).catch(() => {})
+  if (endpoint.directory) await rmdir(endpoint.directory).catch(() => {})
 }
 
