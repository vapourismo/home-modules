{
  "name": "pi-anthropic-sandbox-runtime",
  "version": "0.1.0",
  "description": "Pi extension enforcing Anthropic Sandbox Runtime policies on macOS",
  "private": true,
  "os": [
    "darwin"
  ],
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node --check helper.mjs",
    "test": "node --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "file:vendor/anthropic-ai-sandbox-runtime-0.0.75.tgz"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  }
}
